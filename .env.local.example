# Easy Dataset 环境变量配置示例
# 请复制此文件为 .env.local 并填入真实的配置信息

# ==================== 数据库配置 ====================
DATABASE_URL="file:./prisma/db.sqlite"

# ==================== OBS对象存储配置 (REQ-003) ====================
# 华为云OBS访问密钥 (必需)
# 从华为云控制台 > 我的凭证 > 访问密钥 获取
OBS_ACCESS_KEY=your-access-key-here
OBS_SECRET_KEY=your-secret-key-here

# OBS服务配置 (必需)
# ENDPOINT: OBS服务地址,根据bucket所在区域填写
# 华为云各区域endpoint参考: https://developer.huaweicloud.com/endpoint?OBS
OBS_ENDPOINT=https://obs.cn-north-4.myhuaweicloud.com

# BUCKET: 存储桶名称
OBS_BUCKET=your-bucket-name

# ==================== OBS配置说明 ====================
# 1. 访问密钥获取:
#    - 登录华为云控制台
#    - 进入"我的凭证" > "访问密钥"
#    - 点击"新增访问密钥"创建新的AK/SK
#    - 或使用已有的访问密钥
#
# 2. Endpoint选择:
#    - 华为云北京四: https://obs.cn-north-4.myhuaweicloud.com
#    - 华为云广州: https://obs.cn-south-1.myhuaweicloud.com
#    - 华为云上海一: https://obs.cn-east-3.myhuaweicloud.com
#    - 更多区域请参考华为云文档
#
# 3. Bucket名称:
#    - 在华为云OBS控制台查看bucket名称
#    - 确保该bucket已创建并有读写权限
#
# 4. 权限要求:
#    - 需要对指定bucket有以下权限:
#      * obs:object:GetObject (读取对象)
#      * obs:object:PutObject (上传对象)
#      * obs:object:DeleteObject (删除对象)
#      * obs:bucket:ListBucket (列出对象)
#
# 5. 安全建议:
#    - 不要将.env.local文件提交到Git仓库
#    - 定期轮换访问密钥
#    - 使用最小权限原则配置IAM策略
#    - 生产环境建议使用临时安全凭证(STS Token)

# ==================== 其他配置 ====================
# 可根据项目需要添加其他环境变量
# NEXT_PUBLIC_API_URL=http://localhost:1717
