# Dockerfile.migrate
# 用途: 通用的 Prisma 数据库迁移容器
# 支持: AMD64 (x86_64) / ARM64 (aarch64)

# 使用多架构基础镜像
FROM node:22-alpine

# 声明构建参数（自动注入）
ARG TARGETPLATFORM

WORKDIR /app

# 复制依赖定义
COPY package.json pnpm-lock.yaml ./

# 复制 schema.prisma（初始版本，后续会根据平台修改）
COPY prisma/schema.prisma ./prisma/schema.prisma

# 安装系统依赖
RUN apk add --no-cache \
    sqlite \
    openssl

# 安装 Node.js 依赖
RUN npm install -g pnpm && \
    pnpm install --frozen-lockfile --prod

# ⭐ 根据目标平台设置 Prisma 二进制目标
# 这是关键步骤，确保 Prisma 引擎与平台匹配
RUN if [ "$TARGETPLATFORM" = "linux/arm64" ]; then \
        echo "🔧 配置 ARM64 平台的 Prisma 引擎"; \
        # Alpine Linux ARM64 使用 musl libc
        sed -i 's/binaryTargets = \[.*\]/binaryTargets = ["native", "linux-musl-arm64-openssl-3.0.x"]/' prisma/schema.prisma; \
        export PRISMA_CLI_BINARY_TARGETS="linux-musl-arm64-openssl-3.0.x"; \
    else \
        echo "🔧 配置 AMD64 平台的 Prisma 引擎 (默认)"; \
        # Alpine Linux AMD64 使用 musl libc
        sed -i 's/binaryTargets = \[.*\]/binaryTargets = ["native", "linux-musl-openssl-3.0.x"]/' prisma/schema.prisma; \
        export PRISMA_CLI_BINARY_TARGETS="linux-musl-openssl-3.0.x"; \
    fi && \
    cat prisma/schema.prisma && \
    pnpm add -D prisma@6.9.0 @prisma/client@6.9.0

# 验证 Prisma 引擎安装
RUN echo "✅ 验证 Prisma 安装..." && \
    npx prisma -v

# 创建智能迁移脚本
RUN cat > /app/migrate.sh <<'SCRIPT'
#!/bin/sh
set -e

# ==========================================
# Prisma 数据库迁移工具
# ==========================================

echo "=========================================="
echo "  Prisma 数据库迁移工具 v1.1"
echo "=========================================="
echo "  架构: $(uname -m)"
echo "  平台: $(uname -s)"
echo "  Node: $(node -v)"
echo "  时间: $(date '+%Y-%m-%d %H:%M:%S')"
echo "=========================================="
echo ""

# 显示 Prisma 版本和引擎信息
echo "🔍 Prisma 环境信息:"
npx prisma -v | head -5 | sed 's/^/   /'
echo ""

# ==========================================
# 参数校验
# ==========================================
if [ ! -f /data/db.sqlite ]; then
  echo "❌ 错误: 数据库文件不存在"
  echo ""
  echo "用法:"
  echo "  docker run --rm \\"
  echo "    -v /path/to/prisma:/data \\"
  echo "    IMAGE_NAME"
  echo ""
  echo "示例:"
  echo "  docker run --rm \\"
  echo "    -v \$(pwd)/prisma:/data \\"
  echo "    easy-dataset-migrate:v1.6.0"
  echo ""
  exit 1
fi

echo "✅ 数据库文件检查通过"
echo "   路径: /data/db.sqlite"
echo ""

# ==========================================
# 显示 Schema 信息
# ==========================================
echo "📋 新 Schema 信息:"
echo "   位置: /app/prisma/schema.prisma"
echo ""
echo "   Prisma 引擎目标:"
grep "binaryTargets" /app/prisma/schema.prisma | sed 's/^/     /'
echo ""
echo "   定义的模型:"
grep "^model " /app/prisma/schema.prisma | sed 's/model \(.*\) {/     - \1/' || echo "     (无模型定义)"
echo ""

# ==========================================
# 配置数据库路径
# ==========================================
echo "🔧 配置数据库连接..."

# 修改 schema.prisma 中的数据库 URL 指向挂载的数据库
sed -i 's|url.*=.*env.*DATABASE_URL.*|url = "file:/data/db.sqlite"|' /app/prisma/schema.prisma
sed -i 's|url.*=.*"file:.*\.sqlite"|url = "file:/data/db.sqlite"|' /app/prisma/schema.prisma

echo "   ✅ 数据库路径: /data/db.sqlite"
echo ""

# ==========================================
# 数据库统计（迁移前）
# ==========================================
DB_SIZE=$(du -h /data/db.sqlite | cut -f1)
TABLE_COUNT=$(sqlite3 /data/db.sqlite "SELECT count(*) FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';" 2>/dev/null || echo "0")

echo "📊 迁移前数据库信息:"
echo "   文件大小: $DB_SIZE"
echo "   表数量: $TABLE_COUNT"

# 尝试获取 User 表记录数（如果表存在）
if sqlite3 /data/db.sqlite "SELECT name FROM sqlite_master WHERE type='table' AND name='User';" 2>/dev/null | grep -q User; then
  USER_COUNT=$(sqlite3 /data/db.sqlite "SELECT COUNT(*) FROM User;" 2>/dev/null || echo "N/A")
  echo "   User表记录数: $USER_COUNT"
fi
echo ""

# 显示示例表结构（User 表，如果存在）
if sqlite3 /data/db.sqlite "SELECT name FROM sqlite_master WHERE type='table' AND name='User';" 2>/dev/null | grep -q User; then
  echo "🔍 迁移前表结构示例 (User表):"
  sqlite3 /data/db.sqlite "PRAGMA table_info(User);" 2>/dev/null | head -10 | \
    awk -F'|' '{printf "   %2d | %-20s | %-10s | %s\n", $1, $2, $3, ($4 == 1 ? "NOT NULL" : "NULLABLE")}' || true
  echo ""
fi

# ==========================================
# 备份数据库
# ==========================================
BACKUP_NAME="db.sqlite.backup-$(date +%Y%m%d-%H%M%S)"
echo "💾 备份数据库..."
cp /data/db.sqlite /data/$BACKUP_NAME

# 验证备份
BACKUP_SIZE=$(du -h /data/$BACKUP_NAME | cut -f1)
echo "   ✅ 备份完成"
echo "   备份文件: $BACKUP_NAME"
echo "   备份大小: $BACKUP_SIZE"
echo ""

# ==========================================
# 验证 Schema 语法
# ==========================================
echo "🔍 验证新 Schema 语法..."
if npx prisma validate > /tmp/validate.log 2>&1; then
  echo "   ✅ Schema 验证通过"
else
  echo "   ❌ Schema 验证失败:"
  cat /tmp/validate.log | sed 's/^/      /'
  echo ""
  exit 1
fi
echo ""

# ==========================================
# 执行迁移
# ==========================================
echo "🚀 开始迁移 (旧数据库 → 新 Schema 结构)..."
echo "   ⚠️  此过程可能需要几秒到几分钟"
echo "   ⚠️  请勿中断或关闭终端"
echo ""

# 执行 db push（不生成 Prisma Client，仅更新数据库结构）
# --skip-generate: 跳过 Prisma Client 生成（应用容器会自己生成）
# --accept-data-loss=false: 拒绝可能导致数据丢失的变更（安全保护）
if npx prisma db push --skip-generate --accept-data-loss=false > /tmp/migrate.log 2>&1; then
  echo "   ✅ 迁移执行成功"

  # 显示迁移日志（关键信息）
  if grep -q "Your database is now in sync" /tmp/migrate.log; then
    echo "   ✅ 数据库结构已同步"
  fi
else
  echo "   ❌ 迁移执行失败"
  echo ""
  cat /tmp/migrate.log | sed 's/^/      /'
  echo ""
  echo "   📋 回滚方法:"
  echo "      cp /data/$BACKUP_NAME /data/db.sqlite"
  echo ""
  exit 1
fi
echo ""

# ==========================================
# 验证迁移结果
# ==========================================
echo "🔍 验证迁移结果..."

# 显示迁移后的表结构（User 表）
if sqlite3 /data/db.sqlite "SELECT name FROM sqlite_master WHERE type='table' AND name='User';" 2>/dev/null | grep -q User; then
  echo ""
  echo "   迁移后表结构示例 (User表):"
  sqlite3 /data/db.sqlite "PRAGMA table_info(User);" 2>/dev/null | \
    awk -F'|' '{printf "   %2d | %-20s | %-10s | %s\n", $1, $2, $3, ($4 == 1 ? "NOT NULL" : "NULLABLE")}' || true
fi

# 统计迁移后数据
NEW_TABLE_COUNT=$(sqlite3 /data/db.sqlite "SELECT count(*) FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%';" 2>/dev/null || echo "0")
NEW_DB_SIZE=$(du -h /data/db.sqlite | cut -f1)

if sqlite3 /data/db.sqlite "SELECT name FROM sqlite_master WHERE type='table' AND name='User';" 2>/dev/null | grep -q User; then
  NEW_USER_COUNT=$(sqlite3 /data/db.sqlite "SELECT COUNT(*) FROM User;" 2>/dev/null || echo "N/A")
fi

echo ""
echo "=========================================="
echo "  ✅ 迁移完成！"
echo "=========================================="
echo ""
echo "📊 迁移统计对比:"
echo "   文件大小:  $DB_SIZE → $NEW_DB_SIZE"
echo "   表数量:    $TABLE_COUNT → $NEW_TABLE_COUNT"
if [ -n "$USER_COUNT" ] && [ -n "$NEW_USER_COUNT" ]; then
  echo "   User记录数: $USER_COUNT → $NEW_USER_COUNT"
fi
echo ""
echo "💾 备份信息:"
echo "   备份文件: /data/$BACKUP_NAME"
echo "   恢复命令: cp /data/$BACKUP_NAME /data/db.sqlite"
echo ""
echo "📋 下一步操作:"
echo "   1. 验证应用功能是否正常"
echo "   2. 检查关键数据是否完整"
echo "   3. 确认无误后可删除备份文件"
echo "   4. 重启应用容器"
echo ""
SCRIPT

RUN chmod +x /app/migrate.sh

# 默认执行迁移脚本
CMD ["/app/migrate.sh"]
