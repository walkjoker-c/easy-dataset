generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "darwin", "windows", "debian-openssl-3.0.x", "linux-arm64-openssl-3.0.x", "debian-openssl-1.1.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Projects {
  id                   String                 @id @default(nanoid(12))
  name                 String
  description          String
  globalPrompt         String                 @default("")
  questionPrompt       String                 @default("")
  answerPrompt         String                 @default("")
  labelPrompt          String                 @default("")
  domainTreePrompt     String                 @default("")
  cleanPrompt          String                 @default("")
  defaultModelConfigId String?
  test                 String                 @default("")
  createAt             DateTime               @default(now())
  updateAt             DateTime               @updatedAt
  createdByUserId      String?
  externalId           String?                @unique
  Chunks               Chunks[]
  CustomPrompts        CustomPrompts[]
  DatasetConversations DatasetConversations[]
  Datasets             Datasets[]
  GaPairs              GaPairs[]
  ImageDatasets        ImageDatasets[]
  Images               Images[]
  ModelConfig          ModelConfig[]
  QuestionTemplates    QuestionTemplates[]
  Questions            Questions[]
  Tags                 Tags[]
  Task                 Task[]
  UploadFiles          UploadFiles[]
}

model UploadFiles {
  id        String    @id @default(nanoid())
  projectId String
  fileName  String
  fileExt   String
  path      String
  size      Int
  md5       String
  createAt  DateTime  @default(now())
  updateAt  DateTime  @updatedAt
  GaPairs   GaPairs[]
  project   Projects  @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Chunks {
  id        String      @id @default(nanoid())
  name      String
  projectId String
  fileId    String
  fileName  String
  content   String
  summary   String
  size      Int
  createAt  DateTime    @default(now())
  updateAt  DateTime    @updatedAt
  project   Projects    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  Questions Questions[]

  @@index([projectId])
}

model Tags {
  id        String   @id @default(nanoid())
  label     String
  projectId String
  parentId  String?
  parent    Tags?    @relation("Tags", fields: [parentId], references: [id])
  children  Tags[]   @relation("Tags")
  project   Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Questions {
  id         String   @id @default(nanoid())
  projectId  String
  chunkId    String
  gaPairId   String?
  question   String
  label      String
  answered   Boolean  @default(false)
  imageId    String?
  imageName  String?
  templateId String?
  createAt   DateTime @default(now())
  updateAt   DateTime @updatedAt
  gaPair     GaPairs? @relation(fields: [gaPairId], references: [id])
  chunk      Chunks   @relation(fields: [chunkId], references: [id])
  project    Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([imageId])
  @@index([templateId])
}

model Datasets {
  id            String   @id @default(nanoid())
  projectId     String
  questionId    String
  question      String
  answer        String
  answerType    String?  @default("text")
  chunkName     String
  chunkContent  String
  model         String
  questionLabel String
  cot           String
  confirmed     Boolean  @default(false)
  score         Float    @default(0)
  aiEvaluation  String   @default("")
  tags          String   @default("")
  note          String   @default("")
  other         String   @default("")
  createAt      DateTime @default(now())
  updateAt      DateTime @updatedAt
  project       Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model DatasetConversations {
  id            String   @id @default(nanoid())
  projectId     String
  questionId    String
  question      String
  chunkId       String
  model         String
  questionLabel String
  score         Float    @default(0)
  aiEvaluation  String   @default("")
  tags          String   @default("")
  note          String   @default("")
  scenario      String
  roleA         String
  roleB         String
  turnCount     Int
  maxTurns      Int
  rawMessages   String
  confirmed     Boolean  @default(false)
  createAt      DateTime @default(now())
  updateAt      DateTime @updatedAt
  project       Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model LlmProviders {
  id        String      @id
  name      String
  apiUrl    String
  createAt  DateTime    @default(now())
  updateAt  DateTime    @updatedAt
  LlmModels LlmModels[]
}

model LlmModels {
  id         String       @id @default(nanoid())
  modelId    String
  modelName  String
  providerId String
  createAt   DateTime     @default(now())
  updateAt   DateTime     @updatedAt
  provider   LlmProviders @relation(fields: [providerId], references: [id])
}

model ModelConfig {
  id           String   @id @default(nanoid())
  projectId    String
  providerId   String
  providerName String
  endpoint     String
  apiKey       String
  modelId      String
  modelName    String
  type         String
  temperature  Float
  maxTokens    Int
  topP         Float
  topK         Float
  status       Int
  createAt     DateTime @default(now())
  updateAt     DateTime @updatedAt
  project      Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model Task {
  id             String    @id @default(nanoid())
  projectId      String
  taskType       String
  status         Int
  startTime      DateTime  @default(now())
  endTime        DateTime?
  completedCount Int       @default(0)
  totalCount     Int       @default(0)
  modelInfo      String
  language       String    @default("zh-CN")
  detail         String    @default("")
  note           String    @default("")
  createAt       DateTime  @default(now())
  updateAt       DateTime  @updatedAt
  project        Projects  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model CustomPrompts {
  id         String   @id @default(nanoid())
  projectId  String
  promptType String
  promptKey  String
  language   String
  content    String
  isActive   Boolean  @default(true)
  createAt   DateTime @default(now())
  updateAt   DateTime @updatedAt
  project    Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, promptType, promptKey, language])
  @@index([projectId, promptType])
  @@index([projectId, language])
}

model GaPairs {
  id            String      @id @default(nanoid())
  projectId     String
  fileId        String
  pairNumber    Int
  genreTitle    String
  genreDesc     String
  audienceTitle String
  audienceDesc  String
  isActive      Boolean     @default(true)
  createAt      DateTime    @default(now())
  updateAt      DateTime    @updatedAt
  uploadFile    UploadFiles @relation(fields: [fileId], references: [id], onDelete: Cascade)
  project       Projects    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  questions     Questions[]

  @@unique([fileId, pairNumber])
  @@index([projectId])
  @@index([fileId])
}

model Images {
  id            String          @id @default(nanoid())
  projectId     String
  imageName     String
  path          String
  size          Int
  width         Int?
  height        Int?
  createAt      DateTime        @default(now())
  updateAt      DateTime        @updatedAt
  ImageDatasets ImageDatasets[]
  project       Projects        @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, imageName])
  @@index([projectId])
}

model ImageDatasets {
  id         String   @id @default(nanoid())
  projectId  String
  imageId    String
  imageName  String
  questionId String?
  question   String
  answer     String
  answerType String   @default("text")
  model      String
  confirmed  Boolean  @default(false)
  score      Float    @default(0)
  tags       String   @default("")
  note       String   @default("")
  createAt   DateTime @default(now())
  updateAt   DateTime @updatedAt
  image      Images   @relation(fields: [imageId], references: [id], onDelete: Cascade)
  project    Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([imageId])
  @@index([questionId])
}

model QuestionTemplates {
  id           String   @id @default(nanoid())
  projectId    String
  question     String
  sourceType   String
  answerType   String
  description  String   @default("")
  labels       String   @default("")
  customFormat String   @default("")
  order        Int      @default(0)
  createAt     DateTime @default(now())
  updateAt     DateTime @updatedAt
  project      Projects @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([projectId, sourceType])
}
